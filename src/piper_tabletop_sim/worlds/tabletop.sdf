<?xml version="1.0"?>
<!--
  Gazebo Harmonic tabletop scene for one AgileX PiPER arm + D435i.

  Geometry:
    - worktable top: 0.82 x 0.68 x 0.05 m, top surface z = 0.5504858 m,
      exactly the arm base plane (base_frame z 0.2184858 + arm mount z 0.332).
      The arm base sits directly on the tabletop; no pedestal.
    - wooden block: 0.04 m cube at (0.62, 0.10, 0.5704858), 2 cm above the
      table top, farther from the arm base.

  Wood block material properties (engineering averages, see README):
    density 650 kg/m^3  -> mass 0.0416 kg for a 0.04 m cube
    table friction mu = 0.4; block contact surface mu = 0.9 to pair with
    the rubber-like finger pads (mu = 1.0). This is a simulation contact
    calibration, not a measured coefficient for the real gripper.
    restitution e ~= 0.4 (wood-on-wood range 0.4..0.6)
-->
<sdf version="1.9">
  <world name="piper_tabletop">

    <gravity>0 0 -9.81</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.28 0.29 0.32 1</ambient>
      <background>0.66 0.70 0.76 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0.55 0 0.70</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.35 -1</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.20 0.22 0.27 1</diffuse>
      <direction>0.4 -0.4 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material>
            <ambient>0.20 0.21 0.23 1</ambient>
            <diffuse>0.28 0.29 0.32 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The table top is exactly the arm base plane. -->
    <model name="worktable">
      <static>true</static>
      <pose>0.63 0.187732 0 0 0 0</pose>
      <link name="table">
        <collision name="top_collision">
          <pose>0 0 0.5254858 0 0 0</pose>
          <geometry><box><size>0.82 0.68 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.4</mu><mu2>0.4</mu2></ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.2</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.5254858 0 0 0</pose>
          <geometry><box><size>0.82 0.68 0.05</size></box></geometry>
          <material>
            <ambient>0.42 0.31 0.20 1</ambient>
            <diffuse>0.62 0.46 0.29 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="leg1_collision">
          <pose>-0.34 -0.27 0.2502429 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.5004858</size></box></geometry>
        </collision>
        <collision name="leg2_collision">
          <pose>-0.34 0.27 0.2502429 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.5004858</size></box></geometry>
        </collision>
        <collision name="leg3_collision">
          <pose>0.34 -0.27 0.2502429 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.5004858</size></box></geometry>
        </collision>
        <collision name="leg4_collision">
          <pose>0.34 0.27 0.2502429 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.5004858</size></box></geometry>
        </collision>
        <visual name="legs_visual">
          <pose>0 0 0.2502429 0 0 0</pose>
          <geometry><box><size>0.70 0.05 0.5004858</size></box></geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.27 0.28 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- One 4 cm wooden cube, the only grasp target. -->
    <model name="wood_block">
      <pose>0.62 0.10 0.5704858 0 0 0.28</pose>
      <link name="link">
        <inertial>
          <mass>0.0416</mass>
          <inertia>
            <ixx>1.11e-5</ixx>
            <iyy>1.11e-5</iyy>
            <izz>1.11e-5</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>0.9</mu><mu2>0.9</mu2></ode>
            </friction>
            <bounce>
              <restitution_coefficient>0.4</restitution_coefficient>
              <threshold>0.01</threshold>
            </bounce>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.32 0.19 0.10 1</ambient>
            <diffuse>0.55 0.33 0.17 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual-only camera mount. It has no collision geometry: the arm's
         zero pose folds behind the table and a physical post in that region
         would block the wrist. The D435i itself is part of the robot model at
         base_frame (0.006445, -0.211853, 0.991065). -->
    <model name="camera_stand">
      <static>true</static>
      <link name="stand">
        <visual name="post_visual">
          <pose>-0.10 0.006445 0.6047755 0 0 0</pose>
          <geometry><box><size>0.03 0.03 1.209551</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="arm_visual">
          <pose>0.056 0.006445 1.195 0 0 0</pose>
          <geometry><box><size>0.312 0.03 0.03</size></box></geometry>
          <material>
            <ambient>0.15 0.16 0.18 1</ambient>
            <diffuse>0.24 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
