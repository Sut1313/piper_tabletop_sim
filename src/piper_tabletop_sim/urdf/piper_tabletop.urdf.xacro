<?xml version="1.0"?>
<robot name="piper_tabletop" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo Harmonic tabletop wrapper for one official PiPER arm + D435i.

    Geometry/pose sources:
      - arm links, masses, inertias, joint limits: official AgileX PiPER values
        (same as ag_robot_description/urdf/piper_arm.xacro).
      - gripper: official 70 mm small gripper (joint7/joint8, mimic).
      - arm mount: left arm of the AG robot, (0.187732, -0.249047, 0.332),
        yaw -90 deg relative to base_frame_link.
      - base_frame_link: the AG robot chassis frame at z=0.2184858 m, yaw +90.
        Keeping it means the table top (z=0.5504858) is exactly level with the
        arm base and the camera keeps its AG-robot relative position.
      - camera: D435i body pose and intrinsics copied from AG_robot.urdf.xacro.
        The original head camera is horizontal (navigation view); for a
        tabletop scene camera_pitch_offset defaults to 60 deg down. Set it to
        0.0 to reproduce the exact AG robot attitude.
  -->

  <xacro:include filename="$(find piper_tabletop_sim)/urdf/piper_arm_official.xacro"/>

  <xacro:arg name="camera_pitch_offset" default="1.047197551"/>
  <xacro:arg name="camera_depth_width" default="848"/>
  <xacro:arg name="camera_depth_height" default="480"/>
  <xacro:arg name="camera_depth_fx" default="418.2646789550781"/>
  <xacro:arg name="camera_depth_fy" default="418.2646789550781"/>
  <xacro:arg name="camera_depth_cx" default="424.1576232910156"/>
  <xacro:arg name="camera_depth_cy" default="238.23983764648438"/>
  <xacro:arg name="camera_depth_hfov" default="1.5844149256643074"/>
  <xacro:arg name="camera_clip_near" default="0.28"/>
  <xacro:arg name="camera_clip_far" default="10.0"/>
  <xacro:arg name="camera_update_rate" default="10.0"/>

  <material name="alu"><color rgba="0.78 0.79 0.81 1.0"/></material>
  <material name="dark"><color rgba="0.22 0.22 0.24 1.0"/></material>
  <material name="accent"><color rgba="0.13 0.42 0.85 1.0"/></material>
  <material name="camera_shell"><color rgba="0.16 0.17 0.18 1.0"/></material>

  <!-- Fixed world root. The arm is bolted to the table, not a mobile base. -->
  <link name="world"/>
  <link name="base_footprint"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_frame_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
    </inertial>
  </link>
  <joint name="base_frame_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_frame_link"/>
    <origin xyz="0 0 0.2184858" rpy="0 0 1.5707963"/>
  </joint>

  <!-- Left AG-robot arm mount, with the lift fixed at its zero position. -->
  <xacro:piper_arm prefix="" parent="base_frame_link">
    <origin xyz="0.187732 -0.249047 0.332000" rpy="0 0 -1.5707963"/>
  </xacro:piper_arm>

  <!-- Rubber-like finger pads against wood. Table friction remains mu=0.4. -->
  <gazebo reference="link7"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="link8"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- Intel RealSense D435i (body pose from the AG robot head). -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh scale="0.001 0.001 0.001"
              filename="package://piper_tabletop_sim/meshes/realsense_d435i.stl"/>
      </geometry>
      <material name="camera_shell"/>
    </visual>
    <collision>
      <origin xyz="-0.012525 0 0" rpy="0 0 0"/>
      <geometry><box size="0.02505 0.090 0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.012949985 -0.000005603 0.000055389" rpy="0 0 0"/>
      <mass value="0.072"/>
      <inertia ixx="0.000052350" ixy="0" ixz="0"
               iyy="0.000007515" iyz="0" izz="0.000052365"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_frame_link"/>
    <child link="camera_link"/>
    <origin xyz="0.006445351 -0.211853207 0.991065428"
            rpy="0 $(arg camera_pitch_offset) -1.570796327"/>
  </joint>

  <!-- REP-103 body frame and ROS optical frame. The simulated RGBD sensor is
       pixel-aligned, so the color optical frame coincides with the depth
       optical frame. This keeps the real project's hand-eye child frame name
       available without introducing a fake color/depth baseline. -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <link name="camera_color_frame"/>
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_color_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_color_optical_frame"/>
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796327 0 -1.570796327"/>
  </joint>

  <!-- ros2_control: arm position interfaces + official 70 mm gripper.
       joint8 is state-only; it is driven by the URDF/SDF mimic constraint.
       Do NOT add gz_ros2_control <param name="mimic"> here: the plugin would
       rename the state interface to joint8_mimic and robot_state_publisher
       would stop updating the second finger TF. -->
  <ros2_control name="PiperTabletopSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="position_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:position_joint name="joint1"/>
    <xacro:position_joint name="joint2"/>
    <xacro:position_joint name="joint3"/>
    <xacro:position_joint name="joint4"/>
    <xacro:position_joint name="joint5"/>
    <xacro:position_joint name="joint6"/>
    <joint name="gripper">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.07</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint7">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint8">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find piper_tabletop_sim)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- D435i RGBD sensor, official depth intrinsics. -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435i" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera/depth</topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
      <update_rate>$(arg camera_update_rate)</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>$(arg camera_depth_hfov)</horizontal_fov>
        <image>
          <width>$(arg camera_depth_width)</width>
          <height>$(arg camera_depth_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>$(arg camera_clip_near)</near>
          <far>$(arg camera_clip_far)</far>
        </clip>
        <depth_camera>
          <clip>
            <near>$(arg camera_clip_near)</near>
            <far>$(arg camera_clip_far)</far>
          </clip>
        </depth_camera>
        <lens>
          <intrinsics>
            <fx>$(arg camera_depth_fx)</fx>
            <fy>$(arg camera_depth_fy)</fy>
            <cx>$(arg camera_depth_cx)</cx>
            <cy>$(arg camera_depth_cy)</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
          <p1>0.0</p1><p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</robot>
